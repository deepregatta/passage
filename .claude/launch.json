{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "viewer", "--", "--host", "127.0.0.1"],
      "port": 5174,
      "env": { "VITE_DW_FIXTURE": "demo" }
    },
    {
      "name": "viewer-warehouse",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "viewer", "--", "--host", "127.0.0.1", "--port", "5176"],
      "port": 5176
    },
    {
      "name": "pages-functions",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "wrangler@4.147.0", "pages", "dev", "viewer/dist", "--port", "8789", "--compatibility-date", "2026-07-12"],
      "port": 8789
    },
    {
      "name": "static-dist",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/serve-pages.mjs"],
      "port": 8788
    }
  ]
}

{
  "name": "@deepweather/engine",
  "version": "0.2.0",
  "description": "deepweather per-user analysis engine — pure TS, runs in Node CLI and (later) the browser",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run check:messages && vitest run",
    "cli": "tsx src/cli.ts",
    "make:grib-fixtures": "tsx scripts/make-grib-fixtures.ts",
    "generate:messages": "tsx scripts/generate-message-schemas.ts",
    "check:messages": "tsx scripts/generate-message-schemas.ts --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}

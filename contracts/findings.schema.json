{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepweather.local/contracts/findings.schema.json",
  "title": "Findings — evidence-bearing engine output",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "route_id", "profile_id", "departure_utc", "engine_version", "inputs", "legs", "verdict", "evidence", "unsupported_hazards"],
  "allOf": [{
    "if": { "required": ["identity_version"] },
    "then": { "required": ["passage_id", "route_revision", "decision_hash"] }
  }],
  "properties": {
    "identity_version": { "const": 2 },
    "passage_id": { "type": ["string", "null"], "minLength": 1 },
    "route_revision": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "decision_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "schema_version": { "type": "integer" },
    "snapshot_id": { "type": "string" },
    "route_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "departure_utc": { "type": "string", "format": "date-time" },
    "engine_version": { "type": "string" },
    "inputs": {
      "type": "object",
      "description": "Everything that produced this analysis: prepared run id, forecast-tile run provenance (exact run ids/cycles), route/profile hashes, warnings ref.",
      "required": ["route_hash", "profile_hash"],
      "properties": {
        "prepared_run_id": { "type": ["string", "null"] },
        "synoptic_run_id": { "type": ["string", "null"] },
        "forecast_tiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time_step_h": {
                "type": ["number", "null"],
                "exclusiveMinimum": 0,
                "description": "On a check's `currents` record (2026-11-13, optional and additive): the largest interval, in hours, between consecutive times of the whole time axis of the current grid the check sampled; null when it cannot be determined (fewer than two times, unreadable or non-increasing times). Absent on checks saved before it was recorded."
              }
            }
          }
        },
        "warnings_ref": { "type": ["string", "null"] },
        "route_hash": { "type": "string" },
        "profile_hash": { "type": "string" }
      }
    },
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["leg_id", "eta_range", "hours"],
        "properties": {
          "leg_id": { "type": "string" },
          "eta_range": {
            "type": "object",
            "required": ["slow", "nominal", "fast"],
            "properties": {
              "slow": { "type": "string", "format": "date-time" },
              "nominal": { "type": "string", "format": "date-time" },
              "fast": { "type": "string", "format": "date-time" }
            }
          },
          "sog_kt": { "type": "object" },
          "hours": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "expected": {
                  "type": "object",
                  "description": "Engine semantics passage-audit-4 (2026-11-14, optional and additive): on a leg read at more than one sample point, the values at the one point the boat is at on the nominal (expected) timing at this hour, judged like the row; the row itself is the worst of every point the boat can be at in the hour. Read by whatever counts the expected timing (route summary, expected hours over a limit, route timeline), never by the verdict. Absent on single-point legs and in findings saved earlier.",
                  "required": ["sample_point_id", "wind_kt", "gust_kt", "wind_dir_deg", "twa_deg", "point_of_sail", "limit_status"],
                  "properties": {
                    "sample_point_id": { "type": "string" },
                    "wind_kt": { "type": ["number", "null"] },
                    "gust_kt": { "type": ["number", "null"] },
                    "wind_dir_deg": { "type": ["number", "null"] },
                    "twa_deg": { "type": ["number", "null"] },
                    "point_of_sail": { "type": ["string", "null"] },
                    "limit_status": { "type": "object" },
                    "waves": { "type": ["object", "null"] }
                  }
                }
              }
            }
          },
          "sample_points": {
            "type": "array",
            "minItems": 1,
            "description": "Engine semantics passage-audit-4 (2026-11-14, optional and additive): where the forecast was read on this leg, every audit sample point along it (no more than 10 nm apart), each standing for the stretch from_nm to to_nm from the leg's start. `sample_point` stays the leg's midpoint, a representative position. Absent in findings saved earlier, which read one point per leg near the midpoint.",
            "items": {
              "type": "object",
              "required": ["point_id", "lat", "lon", "from_nm", "to_nm"],
              "properties": {
                "point_id": { "type": "string", "minLength": 1 },
                "lat": { "type": "number", "minimum": -90, "maximum": 90 },
                "lon": { "type": "number", "minimum": -180, "maximum": 180 },
                "from_nm": { "type": "number", "minimum": 0 },
                "to_nm": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "refs"],
        "properties": {
          "kind": { "type": "string" },
          "leg_id": { "type": "string" },
          "window": { "type": "object" },
          "refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["within", "approaching", "exceeds", "insufficient", "warning_active"] },
        "driver_evidence_id": { "type": ["string", "null"] },
        "warning_override": {
          "type": "object",
          "properties": {
            "active": { "type": "boolean" },
            "bulletin_ref": { "type": ["string", "null"] }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "rule_id", "source_kind"],
        "properties": {
          "evidence_id": { "type": "string" },
          "rule_id": { "type": "string", "description": "e.g. W-GUST-03" },
          "model": { "type": ["string", "null"] },
          "run": { "type": ["string", "null"] },
          "leg_id": { "type": ["string", "null"] },
          "valid_time": { "type": ["string", "null"] },
          "value": {},
          "limit": {},
          "units": { "type": ["string", "null"] },
          "source_kind": { "enum": ["deterministic", "ensemble", "currents", "tides", "warning", "synoptic", "emulated"] },
          "member_fraction": {
            "type": "object",
            "required": ["exceed", "total"],
            "properties": {
              "exceed": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 1 }
            }
          },
          "sample_point_id": {
            "type": "string",
            "minLength": 1,
            "description": "Engine semantics passage-audit-4 (2026-11-14, optional and additive): the leg's audit sample point (legs[].sample_points[].point_id) the value was read at, for a rule read per point. Absent in findings saved earlier, and on ensemble counts (a scenario counts when it exceeds at any point the boat can be at in the hour)."
          },
          "model_runs": {
            "type": "array",
            "description": "D-DIVERGE-01: each compared model's own run at valid_time, in model order.",
            "items": {
              "type": "object",
              "required": ["model", "layer", "run_id", "cycle"],
              "properties": {
                "model": { "type": "string" },
                "layer": { "type": ["string", "null"] },
                "run_id": { "type": ["string", "null"] },
                "cycle": { "type": ["string", "null"] }
              }
            }
          },
          "bulletin_ref": {
            "type": "object",
            "required": ["source", "issued_at", "valid_from", "valid_to", "zone_ids"],
            "properties": {
              "source": { "type": "string" },
              "issued_at": { "type": "string", "format": "date-time" },
              "valid_from": { "type": "string", "format": "date-time" },
              "valid_to": { "type": "string", "format": "date-time" },
              "zone_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "status"],
        "properties": {
          "capability": { "type": "string" },
          "status": { "enum": ["assessed", "assessed_emulated", "partially_assessed", "not_assessed"] },
          "detail": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "causal_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "name", "kind", "consequence"],
        "properties": {
          "event_id": { "type": "string" },
          "event_key": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["low", "high", "front", "regime", "gate", "wind_against_current"] },
          "system_id": { "type": "string" },
          "route_intersection": {
            "type": "object",
            "required": ["leg_id", "window_start", "window_end", "eta_sensitivity"],
            "properties": {
              "leg_id": { "type": "string" },
              "window_start": { "type": "string", "format": "date-time" },
              "window_end": { "type": "string", "format": "date-time" },
              "eta_sensitivity": { "type": "number", "minimum": 0 }
            }
          },
          "consequence": {
            "type": "object",
            "required": ["register_plain", "register_pro", "evidence_ids"],
            "properties": {
              "register_plain": { "type": "string" },
              "register_pro": { "type": "string" },
              "evidence_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "unsupported_hazards": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Stated in every report — absence of a warning is never absence of risk."
    }
  }
}

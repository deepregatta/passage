{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepweather.local/contracts/changes.schema.json",
  "title": "Change ledger — previous vs latest analysis (mockup 3)",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "previous_snapshot_id", "entries"],
  "properties": {
    "schema_version": { "type": "integer" },
    "snapshot_id": { "type": "string" },
    "previous_snapshot_id": { "type": ["string", "null"] },
    "verdict_transition": {
      "type": "object",
      "properties": {
        "from": { "type": ["string", "null"] },
        "to": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "description"],
        "properties": {
          "kind": { "enum": ["event_shifted", "value_changed", "event_new", "event_gone", "verdict_changed", "source_updated"] },
          "description": { "type": "string" },
          "previous": {},
          "latest": {},
          "evidence_pair": { "type": "array", "items": { "type": "string" }, "maxItems": 2 }
          ,"rule_id": { "type": "string" }
          ,"leg_id": { "type": ["string", "null"] }
          ,"zone_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "story": {
      "type": "object",
      "required": ["headline_plain", "headline_pro", "material"],
      "properties": {
        "headline_plain": { "type": "string" },
        "headline_pro": { "type": "string" },
        "material": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["change_ref", "before", "after", "why_it_matters", "evidence_ids"],
            "properties": {
              "change_ref": { "type": "integer", "minimum": 0 },
              "before": {},
              "after": {},
              "why_it_matters": { "type": "string" },
              "evidence_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "next_run": {
          "type": "object",
          "required": ["model", "expected_at"],
          "properties": {
            "model": { "type": "string" },
            "expected_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}

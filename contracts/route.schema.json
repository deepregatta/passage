{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepweather.local/contracts/route.schema.json",
  "title": "Route",
  "type": "object",
  "required": ["schema_version", "route_id", "name", "mode", "waypoints"],
  "properties": {
    "schema_version": { "type": "integer" },
    "route_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "mode": { "enum": ["fixed", "user", "computed"] },
    "waypoints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "lat", "lon"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 }
        }
      }
    },
    "speeds_kt": {
      "description": "Through-water scenario speeds unless timing explicitly declares speed_over_ground. Legacy computed routes without timing stored SOG; other legacy routes stored through-water speed.",
      "type": "object",
      "required": ["slow", "nominal", "fast"],
      "properties": {
        "slow": { "type": "number", "exclusiveMinimum": 0 },
        "nominal": { "type": "number", "exclusiveMinimum": 0 },
        "fast": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "timing": {
      "description": "Explicit timing basis. Routed leg durations include current and are valid only for their departure. The routed slow/fast durations retain the existing +/-15 percent SOG approximation, not a calibrated uncertainty model.",
      "oneOf": [
        {
          "type": "object",
          "required": ["basis"],
          "properties": { "basis": { "enum": ["through_water", "speed_over_ground"] } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["basis", "departure_utc", "legs"],
          "properties": {
            "basis": { "const": "routed" },
            "departure_utc": { "type": "string", "format": "date-time" },
            "legs": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object",
                "required": ["leg_id", "duration_ms", "through_water_kt", "speed_over_ground_kt"],
                "properties": {
                  "leg_id": { "type": "string" },
                  "duration_ms": {
                    "type": "object", "required": ["slow", "nominal", "fast"],
                    "properties": {
                      "slow": { "type": "number", "exclusiveMinimum": 0 },
                      "nominal": { "type": "number", "exclusiveMinimum": 0 },
                      "fast": { "type": "number", "exclusiveMinimum": 0 }
                    },
                    "additionalProperties": false
                  },
                  "through_water_kt": { "type": "number", "exclusiveMinimum": 0 },
                  "speed_over_ground_kt": { "type": "number", "exclusiveMinimum": 0 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "polar_ref": { "type": "string", "description": "config/polars/<slug>.json — alternative to speeds_kt" },
    "polar_scaling": { "type": "number", "exclusiveMinimum": 0 },
    "provenance": {
      "type": "object",
      "description": "Required when mode=computed: routing engine version, request, polar used.",
      "properties": {
        "engine_version": { "type": "string" },
        "routing_request": { "type": "object" },
        "polar_ref": { "type": "string" },
        "computed_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "anyOf": [
    { "required": ["speeds_kt"] },
    { "required": ["polar_ref"] }
  ]
}

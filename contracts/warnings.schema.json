{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepweather.local/contracts/warnings.schema.json",
  "title": "Official marine warnings — authority state (brief §7)",
  "type": "object",
  "required": ["schema_version", "fetched_at", "source", "feed_status", "bulletins"],
  "properties": {
    "schema_version": { "type": "integer" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["live", "fixture", "synthetic"] },
        "name": { "type": "string" }
      }
    },
    "feed_status": { "enum": ["ok", "unavailable", "parse-degraded"] },
    "bulletins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["zone_id", "kind", "valid_from", "valid_to", "raw_text"],
        "properties": {
          "zone_id": { "type": "string" },
          "zone_name": { "type": "string" },
          "kind": { "type": "string", "description": "BMS-cote | BMS-large | gale | ..." },
          "severity": { "type": ["string", "null"] },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_to": { "type": "string", "format": "date-time" },
          "raw_text": { "type": "string" },
          "parse_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "coverage_note": { "type": "string" }
  }
}
